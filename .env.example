# Discord bot (same application as API3 DISCORD_CLIENT_ID for deploy/invite)
DISCORD_TOKEN=
CLIENT_ID=

# API3 backend (API3_KEY must match API3 API_KEY_BOT)
API3_URL=http://localhost:5000
API3_KEY=change-me-bot-api-key

# Comma-separated Discord user IDs with owner-only prefix commands
OWNER_DISCORD_IDS=

# TTS — 9router (default when TTS_SPEECH_URL + TTS_API_KEY are set)
# TTS_PROVIDER=9router
# TTS_SPEECH_URL=https://9router.netamaru.id/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=google-tts/id
# TTS_MAX_CHARS=400
# Fallback: TTS_PROVIDER=edge + TTS_VOICE=id-ID-GadisNeural (edge-tts-universal)

# Optional: role ping on ;giveaway / giveaway slash
GIVEAWAY_PING_ROLE_ID=

# Join/leave welcome cards: off when NODE_ENV=development unless set to 1
# WELCOME_CARDS_ENABLED=1
